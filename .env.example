# PostgreSQL connection; create the database first and put real credentials in .env only.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/productpulse?schema=public"

# Leave empty until you create a Groq API key. Keep real credentials in .env only.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Hindsight Cloud defaults. For a dedicated deployment, replace the URL with its API URL.
# Use the exact bank ID (not only its display name); Cloud can create it on first use.
HINDSIGHT_API_KEY=""
HINDSIGHT_API_URL="https://api.hindsight.vectorize.io"
HINDSIGHT_BANK_ID="ProductPulse"

PORT=4000
